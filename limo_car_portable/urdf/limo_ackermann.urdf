				<!-- es ist sehr klein, einfach als Klein definiert wird -->
				<cylinder length="0.0001" radius="0.0001"/>
			</geometry>
		</visual>
		<collision>
			<origin rpy="1.570795 0 0" xyz="0 0.0225 0"/>
			<geometry>
				<cylinder length="0.045" radius="0.034999999999999996"/>
			</geometry>
		</collision>
	</link>
	<joint name="front_left_steer_joint" type="revolute">
		<parent link="base_link"/>
		<child link="front_left_steer_link"/>
		<origin rpy="0 0 0" xyz="0.12 0.084 -0.1"/>
		<axis xyz="0 0 1"/>
		<!-- Paramenten von Herstellern -->
		<limit effort="5" lower="-0.523598767" upper="0.523598767" velocity="0.5"/>
		<dynamics damping="1.0" friction="2.0"/>
	</joint>
	<transmission name="front_left_hinge_trans" type="SimpleTransmission">
		<type>transmission_interface/SimpleTransmission</type>
		<actuator name="front_left_hinge_motor">
			<hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
			<mechanicalReduction>1</mechanicalReduction>
		</actuator>
		<joint name="front_left_steer_joint">
			<hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
